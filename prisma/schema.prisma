// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================= //
//                AUTHENTICATION & USERS             //
// ================================================= //

model User {
  id              String      @id @default(uuid())
  userId          String?     @unique // ID from the external Identity Server
  name            String
  firstName       String?
  lastName        String?
  email           String      @unique
  phoneNumber     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  department      Department? @relation(fields: [departmentId], references: [id])
  departmentId    String?
  customRole      Role?       @relation(fields: [customRoleId], references: [id])
  customRoleId    String?
  assignedLoans   LoanRequest[] @relation("LoanAssignedTo")
  completedStages LoanRequest[] @relation("StageCompletedBy")
  historyEntries  LoanHistoryEntry[]
}

model Department {
  id            String   @id @default(uuid())
  name          String   @unique
  nameLowercase String   @unique // For case-insensitive lookups
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  workflows     WorkflowDefinition[]
  loanAssignments LoanRequest[]           @relation("LoanDepartmentAssignment")
  workflowStages WorkflowStageDefinition[] @relation("StageDepartmentResponsibility")
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  customers  Customer[]
}


model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

// ================================================= //
//                LOAN & WORKFLOW                    //
// ================================================= //

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]
  branchInfo   Branch?       @relation(fields: [branchId], references: [id])
  branchId     String?
}

model LoanType {
  id                 String               @id @default(uuid())
  name               String               @unique
  workflowDefinitions WorkflowDefinition[]
}

model WorkflowDefinition {
  id           String              @id @default(uuid())
  name         String
  description  String?
  department   Department          @relation(fields: [departmentId], references: [id])
  departmentId String
  loanType     LoanType            @relation(fields: [loanTypeId], references: [id])
  loanTypeId   String
  order        Int                 @default(0)
  versions     WorkflowVersion[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([departmentId, loanTypeId])
}

model WorkflowVersion {
  id                   String                    @id @default(uuid())
  workflowDefinition     WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?                 @updatedAt
  loanRequests         LoanRequest[]
}

model WorkflowStageDefinition {
  id                      String                 @id @default(uuid())
  workflowVersion         WorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId       String
  name                    String
  order                   Int
  responsibleDepartment   Department             @relation("StageDepartmentResponsibility", fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  defaultTimelineDays     Int
  percentageWeight        Int
  documentRequirements    DocumentRequirement[]
  availableStatuses       Json?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime?              @updatedAt
  loanRequests            LoanRequest[]          @relation("CurrentStage")
}

model DocumentRequirement {
  id              String                  @id @default(uuid())
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  workflowStageId String
  name            String
  isMandatory     Boolean                 @default(true)
  type            DocumentRequirementType @default(UPLOAD)
  documents       LoanDocument[]
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

model LoanRequest {
  id                   String                   @id @default(uuid())
  loanNumber           String                   @unique
  customer             Customer                 @relation(fields: [customerId], references: [id])
  customerId           String
  loanAmount           Decimal                  @db.Decimal(12, 2)
  loanType             String
  loanPurpose          String
  submittedDate        DateTime
  lastUpdatedDate      DateTime
  stageEntryDate       DateTime?
  isReadyForManagerReview Boolean                  @default(false)
  isUrgent             Boolean                  @default(false)
  isTerminalStage      Boolean                  @default(false)
  currentStageStatus   String?
  
  assignedDepartment   Department?              @relation("LoanDepartmentAssignment", fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId String?
  assignedToUsers      User[]                   @relation("LoanAssignedTo")
  stageCompletedBy     User[]                   @relation("StageCompletedBy")

  workflowVersion      WorkflowVersion?         @relation(fields: [workflowVersionIdMirror], references: [id])
  workflowVersionIdMirror String?
  currentWorkflowStage WorkflowStageDefinition? @relation("CurrentStage", fields: [currentStageIdMirror], references: [id])
  currentStageIdMirror String?
  stageDeadline        DateTime?

  history   LoanHistoryEntry[]
  documents LoanDocument[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model LoanDocument {
  id            String               @id @default(uuid())
  loan          LoanRequest          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        String
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementId String?
  name          String
  status        LoanDocumentStatus
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanHistoryEntry {
  id        String   @id @default(uuid())
  loan      LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
