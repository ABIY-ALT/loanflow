
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  role      UserRole
  department String? // Or link to a Department model: departmentId String?, department Department? @relation(fields: [departmentId], references: [id])
  
  assignedLoanRequests LoanRequest[] @relation("AssignedUserLoans")

  @@map("users")
}

