
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LoanRequest {
  id                        String                @id @default(cuid())
  loanNumber                String                @unique
  loanAmount                Decimal
  loanType                  String
  loanPurpose               String
  submittedDate             DateTime              @default(now())
  lastUpdatedDate           DateTime              @updatedAt
  stageEntryDate            DateTime?
  stageDeadline             DateTime?
  isReadyForManagerReview   Boolean               @default(false)
  isUrgent                  Boolean               @default(false)
  isTerminalStage           Boolean               @default(false)
  currentStageStatus        String?

  // Mirror fields for performance on lookups without joins
  workflowVersionIdMirror     String?
  currentStageIdMirror        String?

  // Relationships
  customer                  Customer              @relation(fields: [customerId], references: [id])
  customerId                String
  assignedToUsers           User[]                @relation("UserAssignedLoanRequests")
  stageCompletedBy          User[]                @relation("UserCompletedLoanStages")
  documents                 LoanDocument[]
  history                   LoanHistoryEntry[]
  currentWorkflowStage      WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])
  workflowVersion           WorkflowVersion?      @relation(fields: [workflowVersionIdMirror], references: [id])
  assignedDepartment        Department?           @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId      String?

  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanDocument {
  id            String      @id @default(cuid())
  name          String
  status        LoanDocumentStatus
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  loan          LoanRequest @relation(fields: [loanId], references: [id])
  loanId        String
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])
  requirementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id        String      @id @default(cuid())
  stageName String
  timestamp DateTime    @default(now())
  notes     String?
  requiredFulfilment String?
  
  loan      LoanRequest @relation(fields: [loanId], references: [id])
  loanId    String
  user      User        @relation(fields: [userId], references: [id])
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowDefinition {
  id           String            @id @default(cuid())
  name         String
  description  String?
  order        Int
  versions     WorkflowVersion[]

  loanType     LoanType          @relation(fields: [loanTypeId], references: [id])
  loanTypeId   String
  department   Department        @relation(fields: [departmentId], references: [id])
  departmentId String

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([departmentId, loanTypeId])
}

model WorkflowVersion {
  id                      String                    @id @default(cuid())
  versionNumber           Int
  isActive                Boolean                   @default(false)
  stages                  WorkflowStageDefinition[]
  
  workflowDefinition      WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id])
  workflowDefinitionId    String

  loanRequests            LoanRequest[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
}

model WorkflowStageDefinition {
  id                      String                  @id @default(cuid())
  name                    String
  defaultTimelineDays     Int
  percentageWeight        Int
  order                   Int
  
  availableStatuses       Json?
  
  workflowVersion         WorkflowVersion         @relation(fields: [workflowVersionId], references: [id])
  workflowVersionId       String
  
  responsibleDepartment   Department              @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  
  documentRequirements    DocumentRequirement[]
  loanRequests            LoanRequest[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime?               @updatedAt
}

model DocumentRequirement {
  id            String                  @id @default(cuid())
  name          String
  isMandatory   Boolean                 @default(true)
  type          DocumentRequirementType @default(UPLOAD)

  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id])
  workflowStageId String

  loanDocuments LoanDocument[]
  
  createdAt     DateTime                @default(now())
  updatedAt     DateTime?               @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

model User {
  id                String       @id @default(cuid())
  userId            String       @unique
  name              String
  email             String       @unique
  firstName         String?
  lastName          String?
  phoneNumber       String?      @unique
  passwordHash      String?
  isPasswordChanged Boolean      @default(false)
  
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  department        Department?  @relation(fields: [departmentId], references: [id])
  departmentId      String?

  customRole        Role?        @relation(fields: [customRoleId], references: [id])
  customRoleId      String?

  assignedLoanRequests LoanRequest[] @relation("UserAssignedLoanRequests")
  completedLoanStages  LoanRequest[] @relation("UserCompletedLoanStages")
  historyEntries     LoanHistoryEntry[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id           String       @id @default(cuid())
  name         String       @unique
  nameLowercase String      @unique
  users        User[]
  workflows    WorkflowDefinition[]
  stages       WorkflowStageDefinition[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model LoanType {
  id        String       @id @default(cuid())
  name      String       @unique
  workflows WorkflowDefinition[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model District {
  id       String    @id @default(cuid())
  name     String    @unique
  branches Branch[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id])
  districtId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([name, districtId])
}
