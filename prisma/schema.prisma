
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// LOAN MANAGEMENT MODELS

model LoanRequest {
  id        String   @id @default(cuid())
  loanNumber      String   @unique
  customerNumber  String
  customerName    String
  customerEmail   String
  customerPhone   String
  customerBranch  String?
  loanAmount      Decimal  @db.Decimal(12, 2)
  loanType        String
  loanPurpose     String
  submittedDate   DateTime @default(now())
  lastUpdatedDate DateTime @updatedAt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Workflow Progression
  currentStageIdMirror        String?
  currentStageStatus          String?
  currentWorkflowStage        WorkflowStageDefinition? @relation("LoansAtStage", fields: [currentStageIdMirror], references: [id])
  
  workflowVersionIdMirror     String?
  workflowVersion             WorkflowVersion? @relation("LoansAtVersion", fields: [workflowVersionIdMirror], references: [id])
  
  assignedDepartmentId String?
  assignedDepartment   Department? @relation("LoansInDepartment", fields: [assignedDepartmentId], references: [id])

  stageEntryDate          DateTime?
  stageDeadline           DateTime?
  isReadyForManagerReview Boolean  @default(false)
  isOverdue               Boolean  @default(false)
  isTerminalStage         Boolean  @default(false)

  // Staff Assignment
  assignedToUserId String?
  assignedToUser   User?   @relation("AssignedLoans", fields: [assignedToUserId], references: [id])

  // Associated Data
  documents LoanDocument[]
  history   LoanHistoryEntry[]
}

model LoanDocument {
  id        String   @id @default(cuid())
  loanId    String
  loanRequest LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name      String
  status    LoanDocumentStatus @default(PENDING)
  filePath  String?
  notes     String?
  uploadedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id        String   @id @default(cuid())
  loanId    String
  loanRequest LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}


// WORKFLOW & DEPARTMENT MODELS

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  nameLowercase String   @unique // For case-insensitive lookups
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // A department can be responsible for many stages across different workflows
  workflowStages WorkflowStageDefinition[] @relation("StagesInDepartment")
  // A department can have users
  users          User[]
  // A department can be assigned to many loans
  assignedLoans  LoanRequest[] @relation("LoansInDepartment")

  // Each Department now has its own Workflow Definition
  workflowDefinition WorkflowDefinition?
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  departmentId String     @unique // Each workflow belongs to one department
  department   Department @relation(fields: [departmentId], references: [id])
  
  versions    WorkflowVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?                 @updatedAt
  stages               WorkflowStageDefinition[]
  
  // Mirror for loan requests using this version
  loanRequestsAtVersionMirror LoanRequest[] @relation("LoansAtVersion")

  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                  String      @id @default(cuid())
  workflowVersionId   String
  workflowVersion     WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  
  name                String
  
  // A stage is owned by one department
  responsibleDepartmentId String
  responsibleDepartment   Department  @relation("StagesInDepartment", fields: [responsibleDepartmentId], references: [id])

  defaultTimelineDays   Int
  requiredDocumentNames String[]
  percentageWeight      Int
  order                 Int
  availableStatuses     Json? // Department-specific statuses
  createdAt             DateTime?   @default(now())
  updatedAt             DateTime?   @updatedAt
  
  // Mirror for loan requests currently at this stage
  loanRequestsAtStageMirror LoanRequest[] @relation("LoansAtStage")

  @@unique([workflowVersionId, order])
}


// USER & ROLE MODELS

model User {
  id            String   @id @default(cuid())
  userId        String?  @unique // ID from the external identity provider (e.g., Auth0, Firebase Auth UID)
  email         String   @unique
  name          String
  firstName     String?
  lastName      String?
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  assignedLoans LoanRequest[] @relation("AssignedLoans")
  historyEntries LoanHistoryEntry[]

  // Role-based access control
  customRoleId  String?
  customRole    Role?   @relation(fields: [customRoleId], references: [id])
}

model Role {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?
  permissions  String[] // Array of permission strings (keys from AppPermission type)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
}
