// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGPOSTGRES_URL_NON_POOLING")
  // shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // Not needed if you handle migrations carefully
}

// App-level Models (core business logic)

model Customer {
  id    String @id @default(cuid())
  name  String
  email String @unique

  phone  String?
  branch String?

  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRequest {
  id String @id @default(cuid())

  // Core Details
  loanNumber String @unique
  loanAmount Decimal @default(0)
  loanType   String
  loanPurpose String

  // Customer Relation
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  // Timestamps & Status
  submittedDate DateTime @default(now())
  lastUpdatedDate DateTime @updatedAt
  stageEntryDate  DateTime @default(now()) // Tracks when the loan entered its current stage
  stageDeadline   DateTime?
  isUrgent        Boolean  @default(false)
  isOverdue       Boolean  @default(false) // This should be a derived field, but kept for simplicity if needed
  isReadyForManagerReview Boolean @default(false)
  isTerminalStage         Boolean @default(false) // True if loan is Closed, Rejected, etc.

  // Workflow & Stage Relations
  // These 'mirror' fields store the ID of the actual stage/version from the workflow models
  // This denormalization helps in querying loans for a specific stage without complex joins.
  workflowVersionIdMirror String?
  currentStageIdMirror    String?
  currentStageStatus      String? // e.g., "In Progress", "On Hold"

  // Relations to Workflow definitions (loosely coupled via the mirror IDs)
  workflowVersion      WorkflowVersion?      @relation(fields: [workflowVersionIdMirror], references: [id], onUpdate: NoAction, onDelete: NoAction)
  currentWorkflowStage WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id], onUpdate: NoAction, onDelete: NoAction)

  // User & Department Assignment
  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  // Many-to-many relationship for assigned users
  assignedToUsers   User[] @relation("AssignedUsers")
  
  // Many-to-many relationship to track which users have completed the current stage
  stageCompletedBy  User[] @relation("StageCompletedBy")

  // Documents & History
  documents LoanDocument[]
  history   LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanDocument {
  id            String  @id @default(cuid())
  name          String // Name of the document, e.g., "Passport"
  status        LoanDocumentStatus @default(PENDING)
  filePath      String? // Path to the stored file
  notes         String?
  uploadedAt    DateTime?
  
  loan          LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        String

  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id        String   @id @default(cuid())
  stageName String // The name of the stage at the time of entry
  timestamp DateTime @default(now())
  notes     String?
  requiredFulfilment String? // If this entry is an information request

  loan      LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Workflow Definition Models

model WorkflowDefinition {
  id           String   @id @default(cuid())
  name         String
  description  String?
  
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  loanType     LoanType @relation(fields: [loanTypeId], references: [id])
  loanTypeId   String
  
  versions     WorkflowVersion[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([departmentId, loanTypeId]) // A department can only have one workflow for a specific loan type
}

model WorkflowVersion {
  id                   String                  @id @default(cuid())
  versionNumber        Int
  isActive             Boolean                 @default(false)
  
  workflowDefinition   WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                  String  @id @default(cuid())
  name                String
  order               Int     // Order of the stage in the workflow
  defaultTimelineDays Int
  percentageWeight    Float   @default(0)

  responsibleDepartment   Department @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String

  documentRequirements DocumentRequirement[]
  availableStatuses Json? // e.g., {"Origination": ["Started", "Info Pending"], "Underwriting": ["In Review"]}

  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId String
  
  loanRequests      LoanRequest[] // This tracks loans currently in this stage
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowVersionId, name])
  @@unique([workflowVersionId, order])
}

model DocumentRequirement {
    id              String      @id @default(cuid())
    name            String
    isMandatory     Boolean     @default(true)
    type            DocumentRequirementType @default(UPLOAD)
    
    workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
    workflowStageId String

    uploadedDocuments LoanDocument[]

    @@unique([workflowStageId, name])
}

// User and Auth Related Models

model User {
  id          String   @id @default(cuid())
  userId      String   @unique // The unique ID from the external identity provider
  email       String   @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  customRoleId String?
  customRole   Role? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  
  // Many-to-many relationship for assigned loans
  assignedLoanRequests LoanRequest[] @relation("AssignedUsers")
  
  // Many-to-many for tracking stage completions
  completedLoanStages LoanRequest[] @relation("StageCompletedBy")
  
  historyEntries LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] // Array of permission strings (AppPermission)
  
  users       User[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id String @id @default(cuid())
  name String @unique
  nameLowercase String @unique // For case-insensitive uniqueness

  users       User[]
  workflowDefinitions WorkflowDefinition[]
  stageDefinitions    WorkflowStageDefinition[]
  loanRequests        LoanRequest[]
}

model LoanType {
  id       String   @id @default(cuid())
  name     String   @unique
  
  workflowDefinitions WorkflowDefinition[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}
