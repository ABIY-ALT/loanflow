
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums
enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

// Models
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  role           UserRole
  departmentName String? // Denormalized from mock data. Could be: department Department? @relation(fields: [departmentId], references: [id]); departmentId String?;

  assignedLoans    LoanRequest[]      @relation("AssignedLoans") // Loans assigned to this user
  historyEntries   LoanHistoryEntry[] // History entries made by this user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id            String    @id @default(cuid())
  name          String    @unique
  nameLowercase String    @unique @map("name_lowercase") // For case-insensitive checks

  workflowStages WorkflowStageDefinition[] // Stages this department is responsible for
  // users          User[] // If relating users to departments directly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  loanType    String   @unique // e.g., "Personal Loan", "Mortgage". This is the key identifier for a workflow type.
  description String?

  versions WorkflowVersion[] // One-to-Many relationship with WorkflowVersion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id            String    @id @default(cuid())
  versionNumber Int
  isActive      Boolean   @default(false) // Application logic needed to ensure only one active per loanType in parent WorkflowDefinition

  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  stages WorkflowStageDefinition[] // One-to-Many relationship with WorkflowStageDefinition

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId, isActive]) // Helps in querying for the active version of a definition
}

model WorkflowStageDefinition {
  id                    String    @id @default(cuid())
  name                  String
  defaultTimelineDays   Int
  requiredDocumentNames String[]  // List of document names required by this stage
  percentageWeight      Int       // Contribution to overall loan progress percentage
  order                 Int       // Defines the sequence of the stage within its version
  isTerminal            Boolean   @default(false) // Indicates if this is a final stage (e.g., Closed, Rejected)

  workflowVersionId String
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  responsibleDepartmentId String
  responsibleDepartment   Department @relation(fields: [responsibleDepartmentId], references: [id])

  // Relation to LoanRequests currently at this stage
  currentLoanRequests LoanRequest[] @relation("CurrentLoanStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowVersionId, order])    // Order must be unique within a version
  @@unique([workflowVersionId, name])     // Stage name must be unique within a version
}

model LoanRequest {
  id               String    @id @default(cuid())
  loanNumber       String    @unique
  customerNumber   String    @unique
  customerName     String
  customerEmail    String
  customerPhone    String
  customerBranch   String?
  loanAmount       Decimal   // Using Decimal for currency precision
  loanType         String    // Denormalized: The loanType this request was initiated with (links to WorkflowDefinition.loanType)
  loanPurpose      String
  submittedDate    DateTime  // Timestamp of when the application was first submitted

  // Link to the current workflow stage this loan is in
  currentWorkflowStageId String
  currentWorkflowStage   WorkflowStageDefinition @relation("CurrentLoanStage", fields: [currentWorkflowStageId], references: [id])

  // Link to the user this loan is assigned to
  assignedToUserId String?
  assignedToUser   User?   @relation("AssignedLoans", fields: [assignedToUserId], references: [id])

  isReadyForManagerReview Boolean  @default(false)
  stageEntryDate          DateTime @default(now()) // Timestamp of when the loan entered its current stage
  stageDeadline           DateTime? // Calculated deadline for the current stage

  // One-to-Many relationships
  history   LoanHistoryEntry[]
  documents LoanDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToUserId])
  @@index([currentWorkflowStageId])
  @@index([loanType])
}

model LoanHistoryEntry {
  id                  String    @id @default(cuid())
  stageName           String    // Denormalized: Name of the stage at the time of this history event
  timestamp           DateTime  // Actual time of the event logged
  notes               String?
  requiredFulfilment  String?   // If this entry logs an information request that needs fulfilling

  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)

  // User who performed the action; can be null if system-generated
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) // Timestamp of when this history record was created
}

model LoanDocument {
  id          String             @id @default(cuid())
  name        String             // e.g., "Passport", "Income Proof"
  status      LoanDocumentStatus
  notes       String?
  uploadedAt  DateTime?          // Timestamp of when the document was (simulated to be) uploaded/re-uploaded

  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
