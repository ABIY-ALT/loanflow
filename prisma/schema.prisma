// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  userId          String             @unique // For external identity provider ID
  name            String
  email           String             @unique
  firstName       String?
  lastName        String?
  phoneNumber     String?            @unique
  passwordHash    String?
  departmentId    String?
  department      Department?        @relation(fields: [departmentId], references: [id])
  customRoleId    String?
  customRole      Role?              @relation(fields: [customRoleId], references: [id])
  assignedLoans   LoanRequest[]      @relation("LoanAssignedTo")
  completedStages LoanRequest[]      @relation("StageCompletedBy")
  historyEntries  LoanHistoryEntry[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([departmentId])
  @@index([customRoleId])
}

model Department {
  id            String                    @id @default(cuid())
  name          String                    @unique
  nameLowercase String                    @unique // For case-insensitive lookups
  users         User[]
  workflows     WorkflowDefinition[]
  stages        WorkflowStageDefinition[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  LoanRequest   LoanRequest[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LoanRequest {
  id                      String    @id @default(cuid())
  loanNumber              String    @unique
  customer                Customer  @relation(fields: [customerId], references: [id])
  customerId              String
  loanAmount              Decimal   @db.Decimal(12, 2)
  loanType                String
  loanPurpose             String
  submittedDate           DateTime  @default(now())
  lastUpdatedDate         DateTime  @updatedAt
  stageEntryDate          DateTime?
  isUrgent                Boolean   @default(false)
  isReadyForManagerReview Boolean   @default(false)
  isTerminalStage         Boolean   @default(false)

  // Stage and Workflow mirrors
  workflowVersionIdMirror String? @map("workflowVersionId")
  currentStageIdMirror    String? @map("currentStageId")
  currentStageStatus      String?

  workflowVersion      WorkflowVersion?         @relation(fields: [workflowVersionIdMirror], references: [id])
  currentWorkflowStage WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])

  // Denormalized/mirrored fields for easier querying
  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])
  stageDeadline        DateTime?

  // Many-to-Many for multiple assignees
  assignedToUsers  User[] @relation("LoanAssignedTo")
  stageCompletedBy User[] @relation("StageCompletedBy")

  // Relations
  documents LoanDocument[]
  history   LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([workflowVersionIdMirror])
  @@index([currentStageIdMirror])
  @@index([assignedDepartmentId])
}

model LoanDocument {
  id            String               @id @default(cuid())
  loanRequest   LoanRequest          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        String
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementId String?
  name          String
  status        LoanDocumentStatus
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([loanId])
  @@index([requirementId])
}

model LoanHistoryEntry {
  id                 String      @id @default(cuid())
  loan               LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId             String
  user               User        @relation(fields: [userId], references: [id])
  userId             String
  stageName          String
  timestamp          DateTime
  notes              String?
  requiredFulfilment String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([loanId])
  @@index([userId])
}

model LoanType {
  id                 String               @id @default(cuid())
  name               String               @unique
  workflowDefinition WorkflowDefinition[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model WorkflowDefinition {
  id           String            @id @default(cuid())
  name         String
  description  String?
  loanType     LoanType          @relation(fields: [loanTypeId], references: [id])
  loanTypeId   String
  department   Department        @relation(fields: [departmentId], references: [id])
  departmentId String
  order        Int
  versions     WorkflowVersion[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([loanTypeId, departmentId])
  @@index([loanTypeId])
  @@index([departmentId])
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId])
}

model WorkflowStageDefinition {
  id                      String                @id @default(cuid())
  workflowVersion         WorkflowVersion       @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId       String
  name                    String
  order                   Int
  responsibleDepartment   Department            @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  defaultTimelineDays     Int
  percentageWeight        Int
  availableStatuses       Json?
  documentRequirements    DocumentRequirement[]
  loanRequests            LoanRequest[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime?

  @@unique([workflowVersionId, name])
  @@unique([workflowVersionId, order])
  @@index([workflowVersionId])
  @@index([responsibleDepartmentId])
}

model DocumentRequirement {
  id              String                  @id @default(cuid())
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  workflowStageId String
  name            String
  isMandatory     Boolean                 @default(true)
  type            DocumentRequirementType @default(UPLOAD)
  loanDocuments   LoanDocument[]

  @@unique([workflowStageId, name])
  @@index([workflowStageId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}
