// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  userId              String    @unique // External Identity ID
  email               String    @unique
  name                String?
  firstName           String?
  lastName            String?
  phoneNumber         String?
  passwordHash        String?
  isPasswordChanged   Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  customRoleId String?
  customRole   Role?   @relation(fields: [customRoleId], references: [id])

  assignedLoans    LoanRequest[]      @relation("AssignedToUsers")
  completedLoans   LoanRequest[]      @relation("StageCompletedBy")
  submittedLoans   LoanRequest[]      @relation("CreatedBy")
  historyEntries   LoanHistoryEntry[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] // Scalar list supported in PostgreSQL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Department {
  id            String   @id @default(uuid())
  name          String   @unique
  nameLowercase String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users               User[]
  workflowDefinitions WorkflowDefinition[]
  workflowStages      WorkflowStageDefinition[]
  assignedLoans       LoanRequest[]
}

model Sector {
  id        String   @id @default(uuid())
  name      String   @unique
  parentId  String?
  parent    Sector?  @relation("SectorToSector", fields: [parentId], references: [id])
  children  Sector[] @relation("SectorToSector")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowDefinitions WorkflowDefinition[]
  loanRequests        LoanRequest[]
}

model RequestType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loanRequests LoanRequest[]
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, districtId])
}

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  phone     String?
  branch    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loanRequests LoanRequest[]
}

model LoanRequest {
  id                      String   @id @default(uuid())
  loanNumber              String   @unique
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id])
  loanAmount              Decimal
  sectorId                String
  sector                  Sector   @relation(fields: [sectorId], references: [id])
  requestTypeId           String
  requestType             RequestType @relation(fields: [requestTypeId], references: [id])
  loanPurpose             String
  submittedDate           DateTime @default(now())
  lastUpdatedDate         DateTime @default(now())
  stageEntryDate          DateTime?
  stageDeadline           DateTime?
  currentStageStatus      String?
  isReadyForManagerReview Boolean  @default(false)
  isUrgent                Boolean  @default(false)
  isTerminalStage         Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id])

  currentStageId       String?
  currentWorkflowStage WorkflowStageDefinition? @relation(fields: [currentStageId], references: [id])

  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])

  assignedToUsers  User[] @relation("AssignedToUsers")
  stageCompletedBy User[] @relation("StageCompletedBy")

  createdById String?
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])

  history   LoanHistoryEntry[]
  documents LoanDocument[]
}

model LoanDocument {
  id            String   @id @default(uuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])
  name          String
  status        String   // PENDING, SUBMITTED, VERIFIED, REJECTED
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoanHistoryEntry {
  id            String   @id @default(uuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  stageName     String
  timestamp     DateTime @default(now())
  notes         String?
  requiredFulfilment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkflowDefinition {
  id           String   @id @default(uuid())
  name         String
  description  String?
  order        Int      @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  sectorId     String
  sector       Sector @relation(fields: [sectorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions WorkflowVersion[]
}

model WorkflowVersion {
  id                   String   @id @default(uuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime? @updatedAt

  stages       WorkflowStageDefinition[]
  loanRequests LoanRequest[]
}

model WorkflowStageDefinition {
  id                      String   @id @default(uuid())
  name                    String
  order                   Int
  defaultTimelineDays     Int      @default(3)
  percentageWeight        Int      @default(0)
  availableStatuses       Json     // Store department-specific statuses as JSON
  workflowVersionId       String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  responsibleDepartmentId String
  responsibleDepartment   Department @relation(fields: [responsibleDepartmentId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime? @updatedAt

  documentRequirements DocumentRequirement[]
  loanRequests         LoanRequest[]
}

model DocumentRequirement {
  id              String   @id @default(uuid())
  name            String
  isMandatory     Boolean  @default(true)
  type            String   // UPLOAD, CHECKBOX
  workflowStageId String
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loanDocuments LoanDocument[]
}
