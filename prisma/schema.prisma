model Workflow {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    WorkflowVersion[]

  @@map("workflows")
}

model WorkflowVersion {
  id                  String   @id @default(uuid())
  workflowId          String
  workflow            Workflow @relation(fields: [workflowId], references: [id])
  versionNumber       Int
  description         String?
  createdAt           DateTime @default(now())
  stages              WorkflowStage[]
  
  loanRequests        LoanRequest[] @relation("LoanWorkflowVersion")

  @@unique([workflowId, versionNumber])
  @@map("workflow_versions")
}

model WorkflowStage {
  id                    String   @id @default(uuid())
  workflowVersionId     String
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  
  name                  String
  responsibleDepartment String // Could be FK to Department model: responsibleDepartmentId String
  // responsibleDepartment Relation<Department> @relation("DepartmentResponsibleForStage", fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays   Int
  requiredDocumentNames String[]
  percentageWeight      Int
  order                 Int // Sequence within the version

  currentLoanRequests   LoanRequest[] @relation("CurrentLoanStage")

  @@map("workflow_stages")
}


model LoanRequest {
  id            String   @id @default(uuid())
  loanNumber    String   @unique
  customerNumber String  @unique
  customerName  String
  customerEmail String
  customerPhone String
  loanAmount    Float
  loanType      String
  loanPurpose   String

  workflowId           String // To know which high-level workflow it belongs to
  workflowVersionId    String // Specific version this loan is following
  workflowVersion      WorkflowVersion @relation("LoanWorkflowVersion", fields: [workflowVersionId], references: [id])
  
  currentWorkflowStageId String   // Current stage ID
  currentWorkflowStage   WorkflowStage @relation("CurrentLoanStage", fields: [currentWorkflowStageId], references: [id])
  
  submittedDate DateTime @default(now())
  lastUpdatedDate DateTime @updatedAt

  assignedDepartment String? // Denormalized from currentWorkflowStage.responsibleDepartment for easier querying
  assignedToId  String?
  assignedTo    User?    @relation("AssignedUserLoans", fields: [assignedToId], references: [id])

  documents Json // Array of LoanDocument objects
  history   Json // Array of LoanHistoryEntry objects
  
  stageDeadline DateTime?
  // isOverdue is a calculated field, not stored
  isReadyForManagerReview Boolean @default(false)

  @@map("loan_requests")
}
