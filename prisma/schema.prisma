
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String // In a real app, this should be a hashed password
  role          UserRole // Still using the enum for now, will be phased out or mapped
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  loanRequests  LoanRequest[] @relation("AssignedToUser")
  historyEntries LoanHistoryEntry[] @relation("UserHistory")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customRoleId  String? // Foreign key for the new Role model
  customRole    Role?       @relation(fields: [customRoleId], references: [id])


  @@index([departmentId])
  @@index([customRoleId])
}

// New Role model for dynamic roles and permissions
model Role {
  id            String    @id @default(cuid())
  name          String    @unique
  description   String?
  permissions   String[]  @default([]) // Stores an array of permission keys
  users         User[]    @relation("customRole") // Users that have this role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
  VIEW_ONLY
}

model Department {
  id            String    @id @default(cuid())
  name          String    @unique
  nameLowercase String    @unique // For case-insensitive lookups
  users         User[]
  workflowStages WorkflowStageDefinition[] @relation("ResponsibleDepartment")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkflowDefinition {
  id          String            @id @default(cuid())
  name        String
  loanType    String            @unique // Ensure loan types are unique for definitions
  description String?
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  loanRequests LoanRequest[]    @relation("WorkflowDefinitionMirror")
}

model WorkflowVersion {
  id                    String                    @id @default(cuid())
  workflowDefinitionId  String
  workflowDefinition    WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber         Int
  isActive              Boolean                   @default(false)
  stages                WorkflowStageDefinition[]
  loanRequests          LoanRequest[]             @relation("WorkflowVersionMirror")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime?                 @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId])
}

model WorkflowStageDefinition {
  id                      String          @id @default(cuid())
  workflowVersionId       String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                    String
  responsibleDepartmentId String
  responsibleDepartment   Department      @relation("ResponsibleDepartment", fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  requiredDocumentNames   String[]        @default([])
  percentageWeight        Int             @default(0)
  order                   Int
  loanRequests            LoanRequest[]   @relation("CurrentWorkflowStage")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime?       @updatedAt

  @@index([workflowVersionId])
  @@index([responsibleDepartmentId])
}

model LoanRequest {
  id                        String     @id @default(cuid())
  loanNumber                String     @unique
  customerNumber            String
  customerName              String
  customerEmail             String
  customerPhone             String
  customerBranch            String?
  loanAmount                Decimal    @db.Decimal(12, 2)
  loanType                  String
  loanPurpose               String
  submittedDate             DateTime   @default(now())
  lastUpdatedDate           DateTime   @updatedAt
  stageEntryDate            DateTime   @default(now())
  stageDeadline             DateTime?
  isReadyForManagerReview   Boolean    @default(false)
  isOverdue                 Boolean    @default(false)
  isTerminalStage           Boolean    @default(false)

  assignedToUserId          String?
  assignedToUser            User?      @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  // Fields to mirror the state for easier querying if needed, but primary relation is through refs
  workflowDefinitionIdMirror  String
  workflowDefinition          WorkflowDefinition @relation("WorkflowDefinitionMirror", fields: [workflowDefinitionIdMirror], references: [id])

  workflowVersionIdMirror     String
  workflowVersion             WorkflowVersion @relation("WorkflowVersionMirror", fields: [workflowVersionIdMirror], references: [id])

  currentStageIdMirror        String
  currentWorkflowStage        WorkflowStageDefinition @relation("CurrentWorkflowStage", fields: [currentStageIdMirror], references: [id])
  
  history                   LoanHistoryEntry[]
  documents                 LoanDocument[]

  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([assignedToUserId])
  @@index([workflowDefinitionIdMirror])
  @@index([workflowVersionIdMirror])
  @@index([currentStageIdMirror])
  @@index([loanType])
  @@index([submittedDate])
  @@index([isOverdue])
}

model LoanDocument {
  id            String              @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest         @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name          String
  status        LoanDocumentStatus
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([loanRequestId])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanHistoryEntry {
  id            String      @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("UserHistory", fields: [userId], references: [id])
  stageName     String
  timestamp     DateTime    @default(now())
  notes         String?
  requiredFulfilment String? // If this entry represents an info request that needs fulfilling
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([loanRequestId])
  @@index([userId])
}
