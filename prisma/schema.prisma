
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== Customer Model ==========
model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Loan and Workflow Models ==========
model LoanRequest {
  id                       String    @id @default(cuid())
  loanNumber               String    @unique
  customer                 Customer  @relation(fields: [customerId], references: [id])
  customerId               String
  loanAmount               Decimal   @db.Decimal(12, 2)
  loanType                 String
  loanPurpose              String
  submittedDate            DateTime  @default(now())
  lastUpdatedDate          DateTime  @updatedAt
  stageEntryDate           DateTime? @default(now())
  stageDeadline            DateTime?
  isReadyForManagerReview  Boolean   @default(false)
  isUrgent                 Boolean   @default(false)
  isOverdue                Boolean   @default(false)
  isTerminalStage          Boolean   @default(false)
  currentStageStatus       String?
  assignedToUsers          User[]    @relation("LoanAssignedTo")
  stageCompletedBy         User[]    @relation("LoanStageCompletedBy")
  assignedDepartmentId     String?
  assignedDepartment       Department? @relation(fields: [assignedDepartmentId], references: [id])
  workflowVersionIdMirror  String?
  workflowVersion          WorkflowVersion? @relation(fields: [workflowVersionIdMirror], references: [id])
  currentStageIdMirror     String?
  currentWorkflowStage     WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])
  history                  LoanHistoryEntry[]
  documents                LoanDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedDepartmentId])
}

model WorkflowDefinition {
  id           String            @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  loanTypeId   String
  loanType     LoanType          @relation(fields: [loanTypeId], references: [id])
  versions     WorkflowVersion[]
  order        Int               @default(0) // Add the order field here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, loanTypeId]) // A department can only have one workflow definition per loan type
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id])
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[] // For reverse relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                      String                  @id @default(cuid())
  name                    String
  workflowVersionId       String
  workflowVersion         WorkflowVersion         @relation(fields: [workflowVersionId], references: [id])
  responsibleDepartmentId String
  responsibleDepartment   Department              @relation(fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  documentRequirements    DocumentRequirement[]
  percentageWeight        Int
  order                   Int
  availableStatuses       Json?
  activeLoanRequests      LoanRequest[] // For reverse relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentRequirement {
  id              String                  @id @default(cuid())
  name            String
  isMandatory     Boolean                 @default(true)
  type            DocumentRequirementType @default(UPLOAD)
  workflowStageId String
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id])
  uploadedDocs    LoanDocument[]
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

model LoanDocument {
  id            String               @id @default(cuid())
  loanId        String
  loan          LoanRequest          @relation(fields: [loanId], references: [id])
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])
  name          String
  status        LoanDocumentStatus
  filePath      String?
  notes         String?
  uploadedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanHistoryEntry {
  id        String   @id @default(cuid())
  loanId    String
  loan      LoanRequest @relation(fields: [loanId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== User and Role Models ==========
model User {
  id                      String             @id @default(cuid())
  userId                  String             @unique // ID from the external Identity Server
  name                    String
  email                   String             @unique
  firstName               String?
  lastName                String?
  phoneNumber             String?
  departmentId            String?
  department              Department?        @relation(fields: [departmentId], references: [id])
  customRoleId            String?
  customRole              Role?              @relation(fields: [customRoleId], references: [id])
  assignedLoans           LoanRequest[]      @relation("LoanAssignedTo")
  completedStages         LoanRequest[]      @relation("LoanStageCompletedBy")
  historyEntries          LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                  String                    @id @default(cuid())
  name                String                    @unique
  nameLowercase       String                    @unique // For case-insensitive checks
  users               User[]
  workflowDefinitions WorkflowDefinition[]
  workflowStages      WorkflowStageDefinition[]
  loanRequests        LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanType {
  id                  String               @id @default(cuid())
  name                String               @unique
  workflowDefinitions WorkflowDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
