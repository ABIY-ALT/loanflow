
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  parent    Sector?  @relation("ParentChildSector", fields: [parentId], references: [id])
  parentId  String?
  children  Sector[] @relation("ParentChildSector")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  workflowDefinitions WorkflowDefinition[]
  loanRequests        LoanRequest[]
}

model RequestType {
  id           String        @id @default(cuid())
  name         String        @unique
  loanRequests LoanRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Department {
  id              String                  @id @default(cuid())
  name            String
  nameLowercase   String                  @unique // For case-insensitive checks
  users           User[]
  workflows       WorkflowDefinition[]
  assignedLoans   LoanRequest[]
  responsibleForStages WorkflowStageDefinition[]
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String

  @@unique([name, districtId])
}


model LoanRequest {
  id             String    @id @default(cuid())
  loanNumber     String    @unique
  customer       Customer  @relation(fields: [customerId], references: [id])
  customerId     String
  loanAmount     Decimal   @db.Decimal(18, 2)
  sectorId       String
  sector         Sector    @relation(fields: [sectorId], references: [id])
  requestTypeId  String
  requestType    RequestType @relation(fields: [requestTypeId], references: [id])
  loanPurpose    String
  
  workflowVersionIdMirror  String?
  workflowVersion          WorkflowVersion? @relation(fields: [workflowVersionIdMirror], references: [id])
  currentStageIdMirror     String?
  currentWorkflowStage     WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])
  currentStageStatus       String?

  submittedDate  DateTime
  lastUpdatedDate DateTime
  stageEntryDate DateTime? // When the loan entered its current stage
  stageDeadline  DateTime?
  
  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])

  assignedToUsers  User[] @relation("LoanAssignedToUsers")
  stageCompletedBy User[] @relation("LoanStageCompletedBy")

  isReadyForManagerReview Boolean @default(false)
  isUrgent                Boolean @default(false)
  isTerminalStage         Boolean @default(false)

  documents LoanDocument[]
  history   LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanDocument {
  id            String    @id @default(cuid())
  loanRequest   LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        String
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementId String?
  name          String
  status        String // e.g., PENDING, SUBMITTED, VERIFIED, REJECTED
  filePath      String?
  notes         String?
  uploadedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id                 String   @id @default(cuid())
  loanRequest        LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId             String
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId             String?
  stageName          String
  timestamp          DateTime
  notes              String?
  requiredFulfilment String? // Stores text of an info request

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                   String        @id @default(cuid())
  userId               String        @unique // From external identity provider
  name                 String
  email                String        @unique
  firstName            String?
  lastName             String?
  phoneNumber          String?       @unique
  passwordHash         String?
  isPasswordChanged    Boolean       @default(false)
  failedLoginAttempts  Int           @default(0)
  lockoutUntil         DateTime?
  isActive             Boolean       @default(true) // New field, defaults to true

  department           Department?   @relation(fields: [departmentId], references: [id])
  departmentId         String?
  customRole           Role?         @relation(fields: [customRoleId], references: [id])
  customRoleId         String?

  assignedLoans     LoanRequest[] @relation("LoanAssignedToUsers")
  completedStages   LoanRequest[] @relation("LoanStageCompletedBy")
  historyEntries    LoanHistoryEntry[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model WorkflowDefinition {
  id           String            @id @default(cuid())
  name         String
  description  String?
  sector       Sector            @relation(fields: [sectorId], references: [id])
  sectorId     String
  department   Department        @relation(fields: [departmentId], references: [id])
  departmentId String
  order        Int               @default(0)
  versions     WorkflowVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id                    String                    @id @default(cuid())
  workflowDefinition    WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId  String
  versionNumber         Int
  isActive              Boolean                   @default(false)
  stages                WorkflowStageDefinition[]
  loanRequests          LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                    String                  @id @default(cuid())
  workflowVersion       WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId     String
  name                  String
  order                 Int
  responsibleDepartment Department              @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  defaultTimelineDays   Int
  percentageWeight      Float
  availableStatuses     Json? // {"DepartmentName": ["Status1", "Status2"]}
  documentRequirements  DocumentRequirement[]
  loanRequests          LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model DocumentRequirement {
  id              String                  @id @default(cuid())
  name            String
  isMandatory     Boolean                 @default(true)
  type            String                  // CHECKBOX, UPLOAD
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  workflowStageId String
  loanDocuments   LoanDocument[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
