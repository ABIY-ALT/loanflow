// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id            String   @id @default(cuid())
  name          String   @unique
  nameLowercase String   @unique // For case-insensitive unique checks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workflowStages WorkflowStageDefinition[] @relation("StageDepartment")
  users          User[]                    @relation("UserDepartment") // Added back-relation

  @@index([nameLowercase])
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  loanType    String   @unique // One definition set per loan type
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions WorkflowVersion[]
}

model WorkflowVersion {
  id                   String   @id @default(cuid())
  workflowDefinitionId String
  versionNumber        Int
  isActive             Boolean  @default(false) // Application logic ensures only one is active per loanType
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workflowDefinition WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  stages             WorkflowStageDefinition[]
  loanRequests       LoanRequest[] // Loans using this specific version

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId, isActive]) // Index to help find active versions
}

model WorkflowStageDefinition {
  id                      String   @id @default(cuid())
  workflowVersionId       String
  name                    String
  responsibleDepartmentId String // Foreign key to Department
  defaultTimelineDays     Int
  requiredDocumentNames   String[] // Array of strings
  percentageWeight        Int
  order                   Int      // Defines sequence within a version
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  responsibleDepartment Department      @relation("StageDepartment", fields: [responsibleDepartmentId], references: [id])
  loanRequests          LoanRequest[]   @relation("CurrentLoanStage") // Loans currently in this stage

  @@unique([workflowVersionId, order])
  @@index([workflowVersionId])
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  role              UserRole
  departmentId      String? // Foreign key to Department
  department        Department?        @relation("UserDepartment", fields: [departmentId], references: [id])
  assignedLoans     LoanRequest[]      @relation("AssignedUserToLoans")
  historyEntries    LoanHistoryEntry[] @relation("UserHistoryEntries")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([departmentId])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanRequest {
  id                           String   @id @default(cuid())
  loanNumber                   String   @unique
  customerNumber               String   @unique
  customerName                 String
  customerEmail                String
  customerPhone                String
  customerBranch               String?
  loanAmount                   Decimal  @db.Decimal(12, 2) // Example: 12 total digits, 2 decimal places
  loanType                     String
  loanPurpose                  String
  workflowDefinitionIdMirror   String // Stores the ID of the workflow definition
  workflowVersionIdMirror      String // Stores the ID of the workflow version
  currentStageIdMirror         String // Stores the ID of the current stage
  submittedDate                DateTime
  lastUpdatedDate              DateTime
  stageEntryDate               DateTime // When the loan entered the current stage
  stageDeadline                DateTime? // Deadline for the current stage
  isReadyForManagerReview      Boolean  @default(false)
  isOverdue                    Boolean  @default(false) // Calculated by application logic or a nightly job
  isTerminalStage              Boolean  @default(false) // Indicates if the loan is in a final closed/rejected state
  assignedToUserId             String? // Foreign Key to User table
  workflowVersionId            String // Foreign key to WorkflowVersion
  currentStageId               String // Foreign key to WorkflowStageDefinition
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  assignedToUser        User?                     @relation("AssignedUserToLoans", fields: [assignedToUserId], references: [id])
  workflowVersion       WorkflowVersion           @relation(fields: [workflowVersionId], references: [id])
  currentWorkflowStage  WorkflowStageDefinition   @relation("CurrentLoanStage", fields: [currentStageId], references: [id])
  history               LoanHistoryEntry[]
  documents             LoanDocument[]

  @@index([assignedToUserId])
  @@index([workflowVersionId])
  @@index([currentStageId])
  @@index([loanType])
  @@index([isReadyForManagerReview])
  @@index([isOverdue])
}

model LoanDocument {
  id            String             @id @default(cuid())
  loanRequestId String
  name          String
  status        LoanDocumentStatus
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)

  @@index([loanRequestId])
}

model LoanHistoryEntry {
  id                  String   @id @default(cuid())
  loanRequestId       String
  userId              String // Foreign Key to User table (who performed action)
  stageName           String // Name of the stage at the time of this entry
  timestamp           DateTime
  notes               String?
  requiredFulfilment  String?  // If this entry logs an info request
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  user        User        @relation("UserHistoryEntries", fields: [userId], references: [id], onDelete: Cascade) // Make sure user exists or handle deletion appropriately

  @@index([loanRequestId])
  @@index([userId])
}
