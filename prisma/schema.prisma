// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Or your chosen provider
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String // In a real app, this should be hashed
  role          UserRole   @default(STAFF) // Existing enum-based role
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assignedLoans    LoanRequest[]      @relation("AssignedToUser")
  historyEntries   LoanHistoryEntry[] @relation("UserHistory")

  // If you want to assign one of the new dynamic roles to a user in the future:
  // customRoleId String?
  // customRole   Role?   @relation(fields: [customRoleId], references: [id])
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
  VIEW_ONLY
}

model Department {
  id            String    @id @default(cuid())
  name          String    @unique
  nameLowercase String    @unique @default("") // For case-insensitive unique checks
  users         User[]
  workflowStages WorkflowStageDefinition[] @relation("StageDepartment")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkflowDefinition {
  id          String            @id @default(cuid())
  name        String
  loanType    String            @unique // Each loan type should have one definition
  description String?
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?                 @updatedAt // Optional, as it might not always be updated

  loanRequests         LoanRequest[]             @relation("LoanWorkflowVersion") // For loans using this specific version

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId])
}

model WorkflowStageDefinition {
  id                      String           @id @default(cuid())
  workflowVersionId       String
  workflowVersion         WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                    String
  responsibleDepartmentId String
  responsibleDepartment   Department       @relation("StageDepartment", fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  requiredDocumentNames   String[]
  percentageWeight        Int              @default(0)
  order                   Int

  currentLoans            LoanRequest[]    @relation("LoanCurrentStage") // For loans currently in this stage

  createdAt               DateTime?        @default(now()) // Made optional for flexibility
  updatedAt               DateTime?        @updatedAt

  @@unique([workflowVersionId, order])
  @@index([workflowVersionId])
  @@index([responsibleDepartmentId])
}

model LoanRequest {
  id                       String    @id @default(cuid())
  loanNumber               String    @unique
  customerNumber           String
  customerName             String
  customerEmail            String
  customerPhone            String
  customerBranch           String?
  loanAmount               Decimal   @db.Decimal(12, 2) // Example precision
  loanType                 String
  loanPurpose              String

  // Mirror fields for direct query/display, denormalized from the stage's relations
  workflowDefinitionIdMirror String
  workflowVersionIdMirror    String
  currentStageIdMirror       String

  // Relation to the specific workflow version being used
  workflowVersionId          String? // Made optional if a loan can exist before full wf assignment
  workflowVersion            WorkflowVersion? @relation("LoanWorkflowVersion", fields: [workflowVersionId], references: [id])

  // Relation to the current stage definition
  currentStageId             String? // Made optional
  currentWorkflowStage       WorkflowStageDefinition? @relation("LoanCurrentStage", fields: [currentStageId], references: [id])


  assignedToUserId         String?
  assignedToUser           User?     @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  submittedDate            DateTime
  lastUpdatedDate          DateTime  @updatedAt
  stageEntryDate           DateTime? // When the loan entered the current stage
  stageDeadline            DateTime?

  isReadyForManagerReview  Boolean   @default(false)
  isOverdue                Boolean   @default(false)
  isTerminalStage          Boolean   @default(false) // Indicates if the loan is in a final (closed/rejected) stage

  documents                LoanDocument[]
  history                  LoanHistoryEntry[]

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([assignedToUserId])
  @@index([loanType])
  @@index([currentStageId])
  @@index([workflowVersionId])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanDocument {
  id            String             @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest        @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name          String
  status        LoanDocumentStatus
  notes         String?
  filePath      String? // Path to the document in storage
  uploadedAt    DateTime?          // When the document was (re)uploaded
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([loanRequestId])
}

model LoanHistoryEntry {
  id                  String      @id @default(cuid())
  loanRequestId       String
  loanRequest         LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId              String      // Could be a user ID or 'system'
  user                User?       @relation("UserHistory", fields: [userId], references: [id], onDelete: SetNull) // Optional relation to User
  stageName           String      // Name of the stage at the time of entry
  timestamp           DateTime
  notes               String?
  requiredFulfilment  String?     // For information requests
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([loanRequestId])
  @@index([userId])
}

// New Role model for dynamic role definitions
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Loan Officer II", "Senior Underwriter", "Compliance Auditor"
  description String?  // Optional description of the role's purpose
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // In the future, you might link users to these roles, e.g.:
  // users User[] @relation("UserCustomRoles")
  // Or link permissions to these roles
  // permissions PermissionAssignment[]
}
