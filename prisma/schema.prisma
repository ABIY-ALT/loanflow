// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  userId                String    @unique
  name                  String
  firstName             String?
  lastName              String?
  email                 String    @unique
  phoneNumber           String?   @unique
  passwordHash          String?
  isPasswordChanged     Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  lockoutUntil          DateTime?
  isActive              Boolean   @default(true) // Added field
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])
  customRoleId          String?
  customRole            Role?     @relation(fields: [customRoleId], references: [id])

  assignedLoans         LoanRequest[]        @relation("AssignedToUsers")
  completedLoanStages   LoanRequest[]        @relation("StageCompletedBy")
  historyEntries        LoanHistoryEntry[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([departmentId])
  @@index([customRoleId])
}

model Department {
  id              String    @id @default(cuid())
  name            String
  nameLowercase   String    @unique
  
  users           User[]
  workflows       WorkflowDefinition[]
  responsibleForStages WorkflowStageDefinition[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id      String @id @default(cuid())
  name    String
  email   String @unique
  phone   String?
  branch  String?

  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRequest {
  id            String    @id @default(cuid())
  loanNumber    String    @unique
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  loanAmount    Decimal   @db.Decimal(18, 2)
  loanPurpose   String
  submittedDate DateTime  @default(now())
  lastUpdatedDate DateTime @updatedAt
  stageEntryDate DateTime @default(now()) // When the loan entered the current stage
  stageDeadline DateTime?

  sectorId      String
  sector        Sector @relation(fields: [sectorId], references: [id])
  requestTypeId String
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])
  
  workflowVersionIdMirror String?
  workflowVersion       WorkflowVersion? @relation(fields: [workflowVersionIdMirror], references: [id])

  currentStageIdMirror  String?
  currentWorkflowStage  WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])
  currentStageStatus    String?
  
  assignedDepartmentId  String?
  assignedDepartment    Department? @relation(fields: [assignedDepartmentId], references: [id])

  assignedToUsers   User[] @relation("AssignedToUsers")
  stageCompletedBy  User[] @relation("StageCompletedBy")
  
  documents       LoanDocument[]
  history         LoanHistoryEntry[]
  
  isUrgent        Boolean @default(false)
  isReadyForManagerReview Boolean @default(false)
  isTerminalStage Boolean @default(false) // If true, the loan process is finished (Approved, Rejected, etc.)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([customerId])
  @@index([workflowVersionIdMirror])
  @@index([currentStageIdMirror])
  @@index([assignedDepartmentId])
}


model LoanHistoryEntry {
  id                String      @id @default(cuid())
  loanRequestId     String
  loanRequest       LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  stageName         String
  timestamp         DateTime
  notes             String?
  requiredFulfilment String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([loanRequestId])
  @@index([userId])
}

model LoanDocument {
  id            String    @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  
  name          String
  status        LoanDocumentStatus
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([loanRequestId])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}


model Sector {
  id        String  @id @default(cuid())
  name      String  @unique
  parentId  String?
  parent    Sector?  @relation("SectorHierarchy", fields: [parentId], references: [id])
  children  Sector[] @relation("SectorHierarchy")

  workflowDefinitions WorkflowDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model RequestType {
  id      String  @id @default(cuid())
  name    String  @unique

  loanRequests LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowDefinition {
  id              String      @id @default(cuid())
  name            String
  description     String?
  order           Int         @default(0)

  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  
  sectorId        String
  sector          Sector      @relation(fields: [sectorId], references: [id])

  versions        WorkflowVersion[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([departmentId])
  @@index([sectorId])
}

model WorkflowVersion {
  id                  String      @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition  WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber       Int
  isActive            Boolean     @default(false)
  stages              WorkflowStageDefinition[]

  loanRequests        LoanRequest[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  @@index([workflowDefinitionId])
}

model WorkflowStageDefinition {
  id                    String    @id @default(cuid())
  workflowVersionId     String
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                  String
  order                 Int
  responsibleDepartmentId String
  responsibleDepartment Department @relation(fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays   Int
  percentageWeight      Int       @default(0)
  
  availableStatuses     Json?

  documentRequirements  DocumentRequirement[]

  // To mirror this relation in LoanRequest
  loanRequestsInStage   LoanRequest[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([workflowVersionId])
}

model DocumentRequirement {
  id              String      @id @default(cuid())
  workflowStageId String
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  name            String
  isMandatory     Boolean     @default(true)
  type            DocumentRequirementType @default(UPLOAD)

  uploadedDocuments LoanDocument[] // One requirement can have many document uploads against it over time
  
  @@index([workflowStageId])
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  districtId  String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
}
