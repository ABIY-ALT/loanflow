
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
}

model User {
  id                      String        @id @default(uuid())
  name                    String
  email                   String        @unique
  role                    UserRole
  loanRequestsAssigned    LoanRequest[] @relation("LoanAssignedToUser")
  // departmentId String? // Future enhancement
  // department Department? @relation(fields: [departmentId], references: [id]) // Future enhancement
}

// model Department { // Future enhancement for more structured department management
//   id String @id @default(uuid())
//   name String @unique
//   users User[]
//   workflowStages WorkflowStage[] @relation("StageResponsibleDepartment")
// }

model Workflow {
  id          String   @id @default(uuid())
  name        String
  loanType    String // e.g., "Personal Loan", "Mortgage"
  description String?
  // isActive removed - version level activation now
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    WorkflowVersion[]
}

model WorkflowVersion {
  id                  String            @id @default(uuid())
  workflowId          String
  workflow            Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionNumber       Int
  createdAt           DateTime          @default(now())
  isActive            Boolean           @default(false) // Only one version active per WorkflowDefinition.loanType
  stages              WorkflowStage[]
  loanRequests        LoanRequest[] // Loans following this specific version
}

model WorkflowStage {
  id                    String    @id @default(uuid())
  workflowVersionId     String
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                  String
  responsibleDepartment String    // Name of the department
  defaultTimelineDays   Int
  requiredDocumentNames String[]
  percentageWeight      Int
  order                 Int       // Defines the sequence of the stage
  loanRequests          LoanRequest[] // Loans currently in this stage

  @@unique([workflowVersionId, order]) // Ensure order is unique within a version
  @@index([workflowVersionId])
}


model LoanRequest {
  id                      String   @id @default(uuid())
  loanNumber              String   @unique
  customerNumber          String   @unique
  customerName            String
  customerEmail           String
  customerPhone           String
  loanAmount              Float
  loanType                String
  loanPurpose             String
  submittedDate           DateTime @default(now())
  lastUpdatedDate         DateTime @updatedAt

  workflowVersionId       String // Points to the specific WorkflowVersion this loan follows
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  
  currentWorkflowStageId  String // Points to a WorkflowStage.id
  currentWorkflowStage    WorkflowStage @relation(fields: [currentWorkflowStageId], references: [id])

  assignedDepartment      String?  // Denormalized from currentWorkflowStage.responsibleDepartment for easier querying
  assignedToId            String?
  assignedTo              User?    @relation("LoanAssignedToUser", fields: [assignedToId], references: [id])

  documents               Json // Array of LoanDocument
  history                 Json // Array of LoanHistoryEntry

  stageDeadline           DateTime?
  // isOverdue is a calculated field, not stored directly
  isReadyForManagerReview Boolean  @default(false)

  @@index([workflowVersionId])
  @@index([currentWorkflowStageId])
  @@index([assignedToId])
  @@index([assignedDepartment])
}
