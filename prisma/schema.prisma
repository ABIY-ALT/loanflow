
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Make sure this environment variable is set
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
}

model User {
  id                   String              @id @default(cuid())
  name                 String
  email                String              @unique
  role                 UserRole
  departmentName       String? // Name of the department, e.g., "Origination"
  loanRequestsAssigned LoanRequest[]       @relation("AssignedUserLoans")
  historyEntries       LoanHistoryEntry[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Department {
  id                        String                    @id @default(cuid())
  name                      String                    @unique // e.g., "Origination", "Underwriting"
  nameLowercase             String                    @unique // For case-insensitive checks
  workflowStageDefinitions  WorkflowStageDefinition[] @relation("StageDepartment")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model WorkflowDefinition {
  id          String            @id @default(cuid())
  name        String
  loanType    String            @unique // Ensures one definition set per loan type
  description String?
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WorkflowVersion {
  id                      String                    @id @default(cuid())
  workflowDefinitionId    String
  workflowDefinition      WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber           Int
  isActive                Boolean                   @default(false) // App logic will ensure only one active per loanType
  stages                  WorkflowStageDefinition[]
  loanRequests            LoanRequest[]             @relation("LoanWorkflowVersion")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId, isActive]) // To efficiently find active versions for a loanType
}

model WorkflowStageDefinition {
  id                        String          @id @default(cuid())
  workflowVersionId         String
  workflowVersion           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                      String
  responsibleDepartmentName String          // Name of the department
  responsibleDepartment     Department      @relation("StageDepartment", fields: [responsibleDepartmentName], references: [name])
  defaultTimelineDays       Int
  requiredDocumentNames     String[] // Prisma uses String[] for text arrays in PostgreSQL
  percentageWeight          Int
  order                     Int
  loanRequestsAtThisStage   LoanRequest[]   @relation("LoanCurrentStage")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@unique([workflowVersionId, order])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanRequest {
  id                           String               @id @default(cuid())
  loanNumber                   String               @unique
  customerNumber               String               @unique
  customerName                 String
  customerEmail                String
  customerPhone                String
  customerBranch               String?
  loanAmount                   Decimal // For currency
  loanType                     String
  loanPurpose                  String
  workflowDefinitionIdMirror   String // Mirror for denormalized ID
  workflowVersionIdMirror      String // Mirror for denormalized ID
  currentStageIdMirror         String // Mirror for denormalized ID
  submittedDate                DateTime
  lastUpdatedDate              DateTime
  stageEntryDate               DateTime // When loan entered the current stage
  stageDeadline                DateTime?
  isReadyForManagerReview      Boolean              @default(false)
  isOverdue                    Boolean              @default(false) // Typically calculated by app logic
  isTerminalStage              Boolean              @default(false)
  assignedToUserId             String?
  assignedToUser               User?                @relation("AssignedUserLoans", fields: [assignedToUserId], references: [id])
  workflowVersionId            String
  workflowVersion              WorkflowVersion      @relation("LoanWorkflowVersion", fields: [workflowVersionId], references: [id])
  currentStageId               String
  currentWorkflowStage         WorkflowStageDefinition @relation("LoanCurrentStage", fields: [currentStageId], references: [id])
  documents                    LoanDocument[]
  history                      LoanHistoryEntry[]
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
}

model LoanDocument {
  id            String             @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest        @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name          String
  status        LoanDocumentStatus
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model LoanHistoryEntry {
  id              String      @id @default(cuid())
  loanRequestId   String
  loanRequest     LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  stageName       String // Name of the workflow stage at the time of entry
  timestamp       DateTime
  notes           String?
  requiredFulfilment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
