datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Department {
  id            String   @id @default(cuid())
  name          String   @unique
  nameLowercase String   @unique @default("") // Used for case-insensitive unique constraint
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]

  workflowStages WorkflowStageDefinition[] @relation("StageResponsibleDepartment")

  @@index([nameLowercase])
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  password      String? // Made optional as per your previous request
  role          UserRole    @default(STAFF)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  loanRequests  LoanRequest[] @relation("AssignedToUser") // Loans this user is assigned to
  historyEntries LoanHistoryEntry[] @relation("HistoryUser") // History entries made by this user

  customRoleId String?
  customRole   Role?   @relation(fields: [customRoleId], references: [id])


  @@index([email])
  @@index([departmentId])
  @@index([customRoleId])
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
  VIEW_ONLY
}

model WorkflowDefinition {
  id          String            @id @default(cuid())
  name        String
  loanType    String            @unique // Ensures one workflow definition per loan type
  description String?
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Mirror fields for LoanRequest, not relations
  // loanRequests LoanRequest[] @relation("LoanWorkflowDefinition")

  @@index([loanType])
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?                 @updatedAt // Optional for initial creation

  // Mirror fields for LoanRequest, not relations
  // loanRequests         LoanRequest[]             @relation("LoanWorkflowVersion")


  @@unique([workflowDefinitionId, versionNumber]) // Each version number must be unique per definition
  @@index([workflowDefinitionId])
  @@index([isActive])
}

model WorkflowStageDefinition {
  id                      String        @id @default(cuid())
  workflowVersionId       String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                    String
  responsibleDepartmentId String
  responsibleDepartment   Department    @relation("StageResponsibleDepartment", fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  requiredDocumentNames   String[]
  percentageWeight        Int           @default(0)
  order                   Int

  // Mirror fields for LoanRequest, not relations
  // currentLoanRequests     LoanRequest[] @relation("LoanCurrentStage")

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt // Optional for initial creation

  @@unique([workflowVersionId, order]) // Order must be unique per version
  @@index([workflowVersionId])
  @@index([responsibleDepartmentId])
}

model LoanRequest {
  id                String    @id @default(cuid())
  loanNumber        String    @unique
  customerNumber    String
  customerName      String
  customerEmail     String
  customerPhone     String
  customerBranch    String?   // Branch where customer applied or is primarily associated
  loanAmount        Decimal
  loanType          String
  loanPurpose       String
  submittedDate     DateTime  @default(now())
  lastUpdatedDate   DateTime  @updatedAt
  stageEntryDate    DateTime  @default(now()) // When the loan entered its current stage
  stageDeadline     DateTime? // Calculated deadline for the current stage

  // --- MIRROR FIELDS for denormalization and easier querying of current state ---
  // These fields store the IDs/references of the *active* workflow components for this loan.
  // They are NOT direct Prisma relations to avoid complex relational updates when workflows change.
  // They should be updated programmatically when a loan moves stages or if its workflow context changes.
  workflowDefinitionIdMirror String
  workflowVersionIdMirror    String
  currentStageIdMirror       String

  // --- ACTUAL PRISMA RELATIONS to current workflow components ---
  // These establish the conceptual link. Use mirror fields for most direct data needs.
  workflowVersion       WorkflowVersion?       @relation(fields: [workflowVersionIdMirror], references: [id], map: "LoanWorkflowVersionForeignKey", onDelete: Restrict)
  currentWorkflowStage  WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id], map: "LoanCurrentStageForeignKey", onDelete: Restrict)


  assignedToUserId String?
  assignedToUser   User?   @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  isReadyForManagerReview Boolean @default(false)
  isOverdue               Boolean @default(false) // Should be calculated based on stageDeadline
  isTerminalStage         Boolean @default(false) // If the loan is in a final stage like Closed, Rejected, Disbursed

  documents LoanDocument[]
  history   LoanHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanType])
  @@index([assignedToUserId])
  @@index([currentStageIdMirror])
  @@index([workflowVersionIdMirror])
  @@index([isOverdue])
  @@index([isReadyForManagerReview])
  @@index([submittedDate])
  @@index([lastUpdatedDate])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanDocument {
  id            String             @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest        @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name          String
  status        LoanDocumentStatus @default(PENDING)
  notes         String?
  uploadedAt    DateTime? // Timestamp when the document was uploaded/submitted
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([loanRequestId])
}

model LoanHistoryEntry {
  id                 String    @id @default(cuid())
  loanRequestId      String
  loanRequest        LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId             String // User who performed the action or system ID
  user               User?     @relation("HistoryUser", fields: [userId], references: [id], onDelete: SetNull) // Null if user deleted
  stageName          String // Name of the stage at the time of entry
  timestamp          DateTime  @default(now())
  notes              String?
  requiredFulfilment String? // If this entry created a requirement, e.g., "Provide payslips"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([loanRequestId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Senior Loan Officer", "Compliance Analyst"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[] // Users assigned this custom role

  @@index([name])
}
