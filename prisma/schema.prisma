// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model LoanRequest {
  id                      String      @id @default(cuid())
  loanNumber              String      @unique
  loanAmount              Decimal
  loanPurpose             String
  submittedDate           DateTime    @default(now())
  lastUpdatedDate         DateTime    @updatedAt
  stageEntryDate          DateTime?
  stageDeadline           DateTime?
  isUrgent                Boolean     @default(false)
  isReadyForManagerReview Boolean     @default(false)
  isTerminalStage         Boolean     @default(false)
  currentStageStatus      String?

  customer         Customer @relation(fields: [customerId], references: [id])
  customerId       String
  sector           Sector   @relation(fields: [sectorId], references: [id])
  sectorId         String
  requestType      RequestType @relation(fields: [requestTypeId], references: [id])
  requestTypeId    String

  workflowVersionIdMirror String?
  currentStageIdMirror    String?
  workflowVersion         WorkflowVersion?      @relation(fields: [workflowVersionIdMirror], references: [id])
  currentWorkflowStage    WorkflowStageDefinition? @relation(fields: [currentStageIdMirror], references: [id])
  
  assignedDepartment        Department?           @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId      String?

  assignedToUsers  User[]       @relation("AssignedToUsers")
  stageCompletedBy User[]       @relation("StageCompletedBy")
  documents        LoanDocument[]
  history          LoanHistoryEntry[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model LoanDocument {
  id            String      @id @default(cuid())
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  loanRequestId String
  name          String
  status        LoanDocumentStatus @default(PENDING)
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementId String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LoanHistoryEntry {
  id        String    @id @default(cuid())
  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  loanRequestId String
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}


model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  
  sector      Sector @relation(fields: [sectorId], references: [id])
  sectorId    String
  
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId String

  versions    WorkflowVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowVersion {
  id                   String                  @id @default(cuid())
  workflowDefinition   WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  versionNumber        Int
  isActive             Boolean                 @default(false)
  stages               WorkflowStageDefinition[]
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime?
  
  loanRequests         LoanRequest[]
  
  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id            String    @id @default(cuid())
  name          String
  order         Int
  defaultTimelineDays Int
  percentageWeight Int @default(0)

  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId String
  
  responsibleDepartment   Department @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  
  documentRequirements DocumentRequirement[]
  availableStatuses Json?

  loanRequests LoanRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime?
}

model DocumentRequirement {
    id String @id @default(cuid())
    name String
    isMandatory Boolean @default(true)
    type DocumentRequirementType @default(UPLOAD)

    workflowStage WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
    workflowStageId String

    loanDocuments LoanDocument[]
}

enum DocumentRequirementType {
    UPLOAD
    CHECKBOX
}

model User {
  id                  String   @id @default(cuid())
  userId              String?  @unique // For external identity provider
  email               String   @unique
  name                String
  firstName           String?
  lastName            String?
  phoneNumber         String?  @unique
  passwordHash        String?
  isPasswordChanged   Boolean  @default(false)
  failedLoginAttempts Int      @default(0)
  lockoutUntil        DateTime?
  imageUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  customRole   Role? @relation(fields: [customRoleId], references: [id])
  customRoleId String?

  assignedLoans    LoanRequest[]      @relation("AssignedToUsers")
  completedStages  LoanRequest[]      @relation("StageCompletedBy")
  historyEntries   LoanHistoryEntry[]
}

model Department {
  id            String      @id @default(cuid())
  name          String      @unique
  nameLowercase String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  users                 User[]
  workflowDefinitions   WorkflowDefinition[]
  workflowStages        WorkflowStageDefinition[]
  loanRequests          LoanRequest[]
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  
  users       User[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    phone     String?
    branch    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    loanRequests LoanRequest[]
}


model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Self-referencing relation
  parentId  String?
  parent    Sector?  @relation("SectorToSector", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Sector[] @relation("SectorToSector")

  workflowDefinitions WorkflowDefinition[]
  loanRequests        LoanRequest[]
}

model RequestType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  loanRequests LoanRequest[]
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, districtId])
}
