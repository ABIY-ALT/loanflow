// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for the application itself
model User {
  id            String      @id @default(cuid())
  userId        String      @unique // This will store the unique ID from the external Identity Server
  name          String
  email         String      @unique
  firstName     String?
  lastName      String?
  phoneNumber   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  customRoleId  String?
  customRole    Role?       @relation(fields: [customRoleId], references: [id])
  assignedLoans LoanRequest[] @relation("AssignedToUser")
  historyEntries LoanHistoryEntry[]
}

// Role model for custom, permission-based roles
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] // Stores an array of permission keys (AppPermission type from src/lib/permissions.ts)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Department model
model Department {
  id           String      @id @default(cuid())
  name         String      @unique
  nameLowercase String     @unique
  users        User[]
  workflowStages WorkflowStageDefinition[]
}

// Main Loan Request model
model LoanRequest {
  id                   String      @id @default(cuid())
  loanNumber           String      @unique
  customerNumber       String
  customerName         String
  customerEmail        String
  customerPhone        String
  customerBranch       String?
  loanAmount           Decimal
  loanType             String
  loanPurpose          String
  submittedDate        DateTime    @default(now())
  lastUpdatedDate      DateTime    @updatedAt
  stageEntryDate       DateTime    @default(now())
  stageDeadline        DateTime?
  isReadyForManagerReview Boolean   @default(false)
  isOverdue            Boolean     @default(false)
  isTerminalStage      Boolean     @default(false)

  // Mirror fields for denormalization and querying
  workflowDefinitionIdMirror String
  workflowVersionIdMirror    String
  currentStageIdMirror       String
  currentStageStatus         String?     // Denormalized status for easier access

  // Relationships
  assignedToUserId      String?
  assignedToUser        User?                  @relation("AssignedToUser", fields: [assignedToUserId], references: [id])
  currentWorkflowStage  WorkflowStageDefinition @relation(fields: [currentStageIdMirror], references: [id])
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionIdMirror], references: [id])

  documents            LoanDocument[]
  history              LoanHistoryEntry[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// Workflow Definition (top-level container)
model WorkflowDefinition {
  id          String            @id @default(cuid())
  name        String
  loanType    String            @unique
  description String?
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Workflow Version
model WorkflowVersion {
  id                      String                    @id @default(cuid())
  workflowDefinitionId    String
  workflowDefinition      WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber           Int
  isActive                Boolean                   @default(false)
  stages                  WorkflowStageDefinition[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  loanRequestsAtVersionMirror LoanRequest[]

  @@unique([workflowDefinitionId, versionNumber])
}

// Workflow Stage Definition
model WorkflowStageDefinition {
  id                      String       @id @default(cuid())
  workflowVersionId       String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                    String
  responsibleDepartmentId String
  responsibleDepartment   Department   @relation(fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  requiredDocumentNames   String[]
  percentageWeight        Int          @default(0)
  order                   Int
  availableStatuses       String[]     @default([])
  loanRequestsAtStageMirror LoanRequest[]

  createdAt               DateTime?    @default(now())
  updatedAt               DateTime?    @updatedAt

  @@unique([workflowVersionId, name])
  @@unique([workflowVersionId, order])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanDocument {
  id           String             @id @default(cuid())
  loanRequestId String
  loanRequest  LoanRequest        @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name         String
  status       LoanDocumentStatus
  filePath     String?
  notes        String?
  uploadedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model LoanHistoryEntry {
  id                String      @id @default(cuid())
  loanRequestId     String
  loanRequest       LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  stageName         String
  timestamp         DateTime
  notes             String?
  requiredFulfilment String?
  createdAt         DateTime?   @default(now())
  updatedAt         DateTime?   @updatedAt
}
