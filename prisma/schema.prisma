datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(cuid())
  userId       String  @unique // ID from the external Identity Server (e.g., JWT sub claim)
  name         String
  email        String  @unique
  firstName    String?
  lastName     String?
  phoneNumber  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  customRoleId String?
  customRole   Role?       @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  loanHistory  LoanHistoryEntry[]
}

model Department {
  id                    String   @id @default(cuid())
  name                  String   @unique
  nameLowercase         String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  users                 User[]
  responsibleForStages  WorkflowStageDefinition[] @relation("ResponsibleDepartmentForStage")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] // In Prisma, array of strings is used. Validation happens at app level.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model LoanType {
  id                 String               @id @default(cuid())
  name               String               @unique
  workflowDefinition WorkflowDefinition[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  loanType    LoanType @relation(fields: [loanTypeId], references: [id])
  loanTypeId  String   @unique // Each loan type has one workflow definition
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    WorkflowVersion[]
}

model WorkflowVersion {
  id                   String                  @id @default(cuid())
  workflowDefinition   WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  versionNumber        Int
  isActive             Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime?               @updatedAt
  stages               WorkflowStageDefinition[]
  loanRequestsAtVersionMirror LoanRequest[] @relation("LoanRequestWorkflowVersion")
  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                      String      @id @default(cuid())
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId       String
  name                    String
  responsibleDepartment   Department  @relation(name: "ResponsibleDepartmentForStage", fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String
  defaultTimelineDays     Int
  requiredDocumentNames   String[]
  percentageWeight        Float
  order                   Int
  availableStatuses       Json        @default("{}") // Store as JSON object, e.g. {"DeptA": ["Status1"], "DeptB": ["Status2"]}
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?   @updatedAt
  loanRequestsAtStageMirror LoanRequest[] @relation("LoanRequestCurrentStage")
  @@unique([workflowVersionId, order])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanRequest {
  id                          String    @id @default(cuid())
  loanNumber                  String    @unique
  customerNumber              String
  customerName                String
  customerEmail               String
  customerPhone               String
  customerBranch              String?
  loanAmount                  Decimal   @db.Decimal(15, 2)
  loanType                    String
  loanPurpose                 String
  
  // Mirror fields for relations
  workflowVersionIdMirror     String?
  currentStageIdMirror        String?

  submittedDate               DateTime
  lastUpdatedDate             DateTime
  stageEntryDate              DateTime?
  stageDeadline               DateTime?

  assignedDepartmentId        String?
  assignedToUserId            String?

  isReadyForManagerReview     Boolean   @default(false)
  isOverdue                   Boolean   @default(false)
  isTerminalStage             Boolean   @default(false)
  
  currentStageStatus          String?   // e.g., "In Progress", "On Hold"

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // RELATIONS
  assignedDepartment          Department?    @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedToUser              User?          @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  documents                   LoanDocument[]
  history                     LoanHistoryEntry[]
  
  // Relations for current stage and version using the mirror fields
  currentWorkflowStage        WorkflowStageDefinition? @relation("LoanRequestCurrentStage", fields: [currentStageIdMirror], references: [id], onDelete: SetNull)
  workflowVersion             WorkflowVersion? @relation("LoanRequestWorkflowVersion", fields: [workflowVersionIdMirror], references: [id], onDelete: SetNull)
}

model LoanDocument {
  id         String             @id @default(cuid())
  loanId     String
  loan       LoanRequest        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name       String
  status     LoanDocumentStatus
  filePath   String?
  notes      String?
  uploadedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model LoanHistoryEntry {
  id        String    @id @default(cuid())
  loanId    String
  loan      LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
