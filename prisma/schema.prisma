
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  role          UserRole? // Built-in role (Admin, Staff, etc.)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  customRoleId  String? // Foreign key for the new Role model
  customRole    Role?       @relation("customRole", fields: [customRoleId], references: [id]) // Corrected: Added relation name
  loansAssigned LoanRequest[] @relation("AssignedUser") // Loans this user is assigned to
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Department {
  id            String      @id @default(cuid())
  name          String      @unique
  nameLowercase String      @unique // For case-insensitive unique constraint
  users         User[]
  stages        WorkflowStageDefinition[] @relation("StageDepartment")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Role {
  id            String      @id @default(cuid())
  name          String      @unique
  description   String?
  permissions   String[]    @default([]) // Stores an array of permission keys
  users         User[]      @relation("customRole") // Users that have this role
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model WorkflowDefinition {
  id        String            @id @default(cuid())
  name      String
  loanType  String            @unique // Each loan type should have one definition container
  description String?
  versions  WorkflowVersion[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  loanRequests LoanRequest[]  @relation("LoanWorkflowDefinition") // Mirror relationship
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]             @relation("LoanWorkflowVersion") // Loans using this specific version (mirror)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId, isActive]) // Index for finding active version per loan type
}

model WorkflowStageDefinition {
  id                      String          @id @default(cuid())
  workflowVersionId       String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                    String
  responsibleDepartmentId String
  responsibleDepartment   Department      @relation("StageDepartment", fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays     Int
  requiredDocumentNames   String[]
  percentageWeight        Int             @default(0)
  order                   Int
  loanRequestsAsCurrent   LoanRequest[]   @relation("LoanCurrentStage") // Loans currently in this stage (mirror)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([workflowVersionId, order])
  @@index([workflowVersionId])
}

model LoanRequest {
  id                         String            @id @default(cuid())
  loanNumber                 String            @unique
  customerNumber             String
  customerName               String
  customerEmail              String
  customerPhone              String
  customerBranch             String?
  loanAmount                 Decimal           @db.Decimal(12, 2)
  loanType                   String
  loanPurpose                String
  submittedDate              DateTime          @default(now())
  lastUpdatedDate            DateTime          @updatedAt
  stageEntryDate             DateTime          @default(now())
  stageDeadline              DateTime?
  isReadyForManagerReview    Boolean           @default(false)
  isOverdue                  Boolean           @default(false)
  isTerminalStage            Boolean           @default(false) // Indicates if the loan is in a final stage (Closed, Rejected, etc.)

  // Direct Prisma relations for active workflow pointers
  workflowDefinitionIdMirror String // Mirror for faster querying if needed, points to WorkflowDefinition.id
  workflowVersionIdMirror    String // Mirror for WorkflowVersion.id
  currentStageIdMirror       String // Mirror for WorkflowStageDefinition.id

  workflowDefinition         WorkflowDefinition @relation("LoanWorkflowDefinition", fields: [workflowDefinitionIdMirror], references: [id])
  workflowVersion            WorkflowVersion    @relation("LoanWorkflowVersion", fields: [workflowVersionIdMirror], references: [id])
  currentWorkflowStage       WorkflowStageDefinition @relation("LoanCurrentStage", fields: [currentStageIdMirror], references: [id])

  assignedToUserId           String?
  assignedToUser             User?             @relation("AssignedUser", fields: [assignedToUserId], references: [id])

  documents                  LoanDocument[]
  history                    LoanHistoryEntry[] @relation("LoanHistory")

  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([assignedToUserId])
  @@index([currentStageIdMirror])
  @@index([workflowVersionIdMirror])
  @@index([isOverdue])
  @@index([isReadyForManagerReview])
}

model LoanDocument {
  id            String               @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest          @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  name          String
  status        LoanDocumentStatus
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([loanRequestId])
}

model LoanHistoryEntry {
  id                  String      @id @default(cuid())
  loanRequestId       String
  loanRequest         LoanRequest @relation("LoanHistory", fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId              String // Could be system ID or User ID
  stageName           String
  timestamp           DateTime    @default(now())
  notes               String?
  requiredFulfilment  String?    // If this entry logs an info request, this is the text of requirement
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([loanRequestId])
  @@index([userId])
}

enum UserRole {
  ADMIN
  RELATIONSHIP_MANAGER
  UNDERWRITER
  STAFF
  VIEW_ONLY
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}
