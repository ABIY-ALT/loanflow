// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// Loan Flow Specific Models

model LoanRequest {
  id              String       @id @default(cuid())
  loanNumber      String       @unique
  customerNumber  String
  customerName    String
  customerEmail   String
  customerPhone   String
  customerBranch  String?
  loanAmount      Float
  loanType        String
  loanPurpose     String
  
  submittedDate   DateTime     @default(now())
  lastUpdatedDate DateTime     @updatedAt
  stageEntryDate  DateTime     @default(now())
  stageDeadline   DateTime?

  isReadyForManagerReview Boolean @default(false)
  isOverdue               Boolean @default(false)
  isTerminalStage         Boolean @default(false) // For stages like 'Closed' or 'Rejected' to stop overdue tracking

  // User and Department Assignment
  assignedToUser     User?     @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  assignedToUserId String?

  // Workflow tracking mirrors - avoids complex recursive lookups on every read
  workflowDefinitionIdMirror String
  workflowVersionIdMirror    String
  currentStageIdMirror       String
  currentStageStatus         String? // e.g., 'In Progress', 'On Hold'

  // Relationships
  documents LoanDocument[]
  history   LoanHistoryEntry[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanDocument {
  id        String   @id @default(cuid())
  name      String
  status    LoanDocumentStatus
  filePath  String?
  notes     String?
  uploadedAt DateTime?

  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id])
  loanRequestId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanHistoryEntry {
  id        String   @id @default(cuid())
  stageName String
  timestamp DateTime
  notes     String?
  requiredFulfilment String? // Stores the text of the required action

  user          User   @relation(fields: [userId], references: [id])
  userId        String

  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id])
  loanRequestId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Workflow models
model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  loanType    String   @unique // Each loan type has one definition container
  description String?
  
  versions    WorkflowVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowVersion {
  id        String   @id @default(cuid())
  versionNumber Int
  isActive  Boolean  @default(false)

  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  workflowDefinitionId String
  
  stages    WorkflowStageDefinition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                  String   @id @default(cuid())
  name                String
  order               Int
  defaultTimelineDays Int
  percentageWeight    Float
  requiredDocumentNames String[]
  availableStatuses String[] @default(["Initiated", "In Progress", "Completed"]) // New Field

  responsibleDepartment   Department @relation(fields: [responsibleDepartmentId], references: [id])
  responsibleDepartmentId String

  workflowVersion      WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  workflowVersionId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowVersionId, order])
  @@unique([workflowVersionId, name])
}

// User and Auth related models
model User {
  id          String   @id @default(cuid())
  userId      String   @unique // ID from the external Identity Server
  email       String   @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String?

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  customRole   Role? @relation(fields: [customRoleId], references: [id])
  customRoleId String?

  assignedLoans LoanRequest[] @relation("AssignedTo")
  historyEntries LoanHistoryEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id            String   @id @default(cuid())
  name          String   @unique
  nameLowercase String   @unique // For case-insensitive checks
  
  users   User[]
  workflowStages WorkflowStageDefinition[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for custom, app-specific roles
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] // Stores an array of permission strings

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
