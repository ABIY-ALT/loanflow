// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  userId        String    @unique // From external identity provider
  name          String
  firstName     String?
  lastName      String?
  email         String    @unique
  phoneNumber   String?   @unique
  passwordHash  String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  customRoleId  String?
  customRole    Role?       @relation(fields: [customRoleId], references: [id])
  isPasswordChanged Boolean @default(false)
  isActive      Boolean     @default(true) // Ensure new users are active by default
  failedLoginAttempts Int   @default(0)
  lockoutUntil        DateTime?

  assignedLoanRequests LoanRequest[] @relation("AssignedToUsers")
  completedLoanStages  LoanRequest[] @relation("StageCompletedBy")
  historyEntries       LoanHistoryEntry[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRequest {
  id             String      @id @default(cuid())
  loanNumber     String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  loanAmount     Decimal
  
  sectorId      String
  sector        Sector @relation(fields: [sectorId], references: [id])
  requestTypeId String
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])
  
  loanPurpose    String
  submittedDate  DateTime
  lastUpdatedDate DateTime
  stageDeadline  DateTime?
  isUrgent       Boolean     @default(false)

  // Stage and Workflow Management
  workflowVersionIdMirror String
  workflowVersion         WorkflowVersion @relation(fields: [workflowVersionIdMirror], references: [id])
  currentStageIdMirror    String
  currentWorkflowStage    WorkflowStageDefinition @relation(fields: [currentStageIdMirror], references: [id])
  assignedDepartmentId    String?
  assignedDepartment      Department? @relation(fields: [assignedDepartmentId], references: [id])
  currentStageStatus      String?
  stageEntryDate          DateTime?
  isReadyForManagerReview Boolean     @default(false)
  isTerminalStage         Boolean     @default(false)
  
  assignedToUsers         User[]      @relation("AssignedToUsers")
  stageCompletedBy        User[]      @relation("StageCompletedBy")
  
  history        LoanHistoryEntry[]
  documents      LoanDocument[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id      String    @id @default(cuid())
  name    String
  email   String    @unique
  phone   String?
  branch  String?
  
  loanRequests LoanRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model LoanDocument {
  id           String    @id @default(cuid())
  loanId       String
  loanRequest  LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  name         String
  status       LoanDocumentStatus
  filePath     String?
  notes        String?
  uploadedAt   DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id                 String      @id @default(cuid())
  loanId             String
  loanRequest        LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  stageName          String
  timestamp          DateTime
  notes              String?
  requiredFulfilment String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----- Configuration Models -----

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  parentId  String?
  parent    Sector?  @relation("SectorHierarchy", fields: [parentId], references: [id])
  children  Sector[] @relation("SectorHierarchy")
  
  loanRequests          LoanRequest[] // This is the added back-relation
  workflowDefinitions   WorkflowDefinition[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestType {
  id           String    @id @default(cuid())
  name         String    @unique
  loanRequests LoanRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id            String    @id @default(cuid())
  name          String    @unique
  nameLowercase String    @unique // For case-insensitive checks
  
  users                 User[]
  workflowDefinitions   WorkflowDefinition[]
  loanRequests          LoanRequest[] // This is the added back-relation
  stagesOwned           WorkflowStageDefinition[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model District {
    id       String   @id @default(cuid())
    name     String   @unique
    branches Branch[]
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Branch {
    id         String   @id @default(cuid())
    name       String
    districtId String
    district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    @@unique([name, districtId])
}


// ----- Workflow Models -----

model WorkflowDefinition {
  id            String            @id @default(cuid())
  name          String
  departmentId  String
  department    Department        @relation(fields: [departmentId], references: [id])
  sectorId      String
  sector        Sector            @relation(fields: [sectorId], references: [id])
  description   String?
  versions      WorkflowVersion[]
  order         Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id                   String                    @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStageDefinition {
  id                    String        @id @default(cuid())
  name                  String
  workflowVersionId     String
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  responsibleDepartmentId String
  responsibleDepartment Department @relation(fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays   Int
  documentRequirements  DocumentRequirement[]
  percentageWeight      Int
  order                 Int
  availableStatuses     Json? // e.g., { "Underwriting": ["Pending", "In Review"], "Credit": ["Approved"] }

  loanRequestsAtThisStage LoanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentRequirement {
  id            String    @id @default(cuid())
  name          String
  isMandatory   Boolean
  type          DocumentRequirementType
  workflowStageId String
  workflowStage WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)

  loanDocuments LoanDocument[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}
