// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================
//          AUTHENTICATION
// ==================================

model User {
  id                  String   @id @default(uuid())
  userId              String   @unique // User ID from the external identity provider
  name                String
  firstName           String?
  lastName            String?
  email               String   @unique
  phoneNumber         String?  @unique
  passwordHash        String?
  isPasswordChanged   Boolean  @default(false)
  failedLoginAttempts Int      @default(0)
  lockoutUntil        DateTime?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  customRoleId String?
  customRole   Role?       @relation(fields: [customRoleId], references: [id])

  assignedLoanRequests LoanRequest[] @relation("AssignedUsers")
  completedLoanStages  LoanRequest[] @relation("LoanStageCompletions")

  historyEntries LoanHistoryEntry[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// ==================================
//        LOAN CONFIGURATION
// ==================================

model Department {
  id            String   @id @default(uuid())
  name          String
  nameLowercase String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                 User[]
  workflowDefinitions   WorkflowDefinition[]
  loanRequestsAssigned  LoanRequest[] // Back-relation for assignedDepartment
  responsibleForStages  WorkflowStageDefinition[]
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, districtId])
}


model Sector {
  id         String  @id @default(uuid())
  name       String  @unique
  parentId   String?
  parent     Sector? @relation("SectorHierarchy", fields: [parentId], references: [id])
  children   Sector[] @relation("SectorHierarchy")
  loanRequests LoanRequest[]
  workflowDefinitions WorkflowDefinition[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RequestType {
  id    String @id @default(uuid())
  name  String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loanRequests LoanRequest[]
}


model WorkflowDefinition {
  id           String            @id @default(uuid())
  name         String
  description  String?
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  sectorId     String
  sector       Sector            @relation(fields: [sectorId], references: [id])
  order        Int               @default(0)
  versions     WorkflowVersion[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkflowVersion {
  id                   String                    @id @default(uuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?
}

model WorkflowStageDefinition {
  id                  String                 @id @default(uuid())
  name                String
  workflowVersionId   String
  workflowVersion     WorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  responsibleDepartmentId String
  responsibleDepartment Department           @relation(fields: [responsibleDepartmentId], references: [id])
  defaultTimelineDays Int                    @default(1)
  percentageWeight    Int                    @default(0)
  order               Int
  availableStatuses   Json                   @default("{}")
  documentRequirements DocumentRequirement[]
  loanRequests        LoanRequest[]          @relation(name: "CurrentStageOnLoan")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime?
}

model DocumentRequirement {
  id              String                    @id @default(uuid())
  name            String
  isMandatory     Boolean                   @default(true)
  type            DocumentRequirementType   @default(UPLOAD)
  workflowStageId String
  workflowStage   WorkflowStageDefinition   @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  uploadedDocs    LoanDocument[]
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

// ==================================
//         CORE LOAN DATA
// ==================================

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LoanRequest {
  id                String  @id @default(uuid())
  loanNumber        String  @unique
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  loanAmount        Decimal
  sectorId          String
  sector            Sector @relation(fields: [sectorId], references: [id])
  requestTypeId     String
  requestType       RequestType @relation(fields: [requestTypeId], references: [id])
  loanPurpose       String

  workflowVersionIdMirror String?
  workflowVersion         WorkflowVersion?          @relation(fields: [workflowVersionIdMirror], references: [id])
  currentStageIdMirror    String?
  currentWorkflowStage    WorkflowStageDefinition?  @relation(name: "CurrentStageOnLoan", fields: [currentStageIdMirror], references: [id])
  currentStageStatus      String?

  submittedDate     DateTime  @default(now())
  lastUpdatedDate   DateTime  @updatedAt
  stageEntryDate    DateTime?
  stageDeadline     DateTime?
  isUrgent          Boolean   @default(false)
  isTerminalStage   Boolean   @default(false)
  isReadyForManagerReview Boolean @default(false)

  assignedDepartmentId  String?
  assignedDepartment    Department? @relation(fields: [assignedDepartmentId], references: [id])

  assignedToUsers User[] @relation("AssignedUsers")
  stageCompletedBy User[] @relation("LoanStageCompletions")

  history   LoanHistoryEntry[]
  documents LoanDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistoryEntry {
  id                 String      @id @default(uuid())
  loanRequestId      String
  loanRequest        LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  stageName          String
  timestamp          DateTime    @default(now())
  notes              String?
  requiredFulfilment String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime?
}

model LoanDocument {
  id            String      @id @default(uuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  name        String
  status      LoanDocumentStatus
  filePath    String?
  notes       String?
  uploadedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}
