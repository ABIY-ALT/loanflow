
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  branch       String?
  loanRequests LoanRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id                  String         @id @default(uuid())
  userId              String         @unique
  name                String
  email               String         @unique
  firstName           String?
  lastName            String?
  phoneNumber         String?        @unique
  passwordHash        String?
  isPasswordChanged   Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  isActive            Boolean        @default(true)
  departmentId        String?
  department          Department?    @relation(fields: [departmentId], references: [id])
  customRoleId        String?
  customRole          Role?          @relation(fields: [customRoleId], references: [id])
  assignedLoans       LoanRequest[]  @relation("AssignedToUsers")
  completedStages     LoanRequest[]  @relation("StageCompletedBy")
  historyEntries      LoanHistoryEntry[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([departmentId])
  @@index([customRoleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoanRequest {
  id                   String      @id @default(uuid())
  loanNumber           String      @unique
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id])
  loanAmount           Decimal     @db.Decimal(18, 2)
  sectorId             String
  sector               Sector      @relation(fields: [sectorId], references: [id])
  requestTypeId        String
  requestType          RequestType @relation(fields: [requestTypeId], references: [id])
  loanPurpose          String
  submittedDate        DateTime    @default(now())
  lastUpdatedDate      DateTime    @updatedAt
  stageEntryDate       DateTime?
  stageDeadline        DateTime?
  isUrgent             Boolean     @default(false)
  isReadyForManagerReview Boolean     @default(false)
  isTerminalStage      Boolean     @default(false)
  assignedToUsers      User[]      @relation("AssignedToUsers")
  stageCompletedBy     User[]      @relation("StageCompletedBy")
  documents            LoanDocument[]
  history              LoanHistoryEntry[]
  workflowVersionIdMirror String
  workflowVersion      WorkflowVersion @relation(fields: [workflowVersionIdMirror], references: [id])
  currentStageIdMirror String
  currentWorkflowStage WorkflowStageDefinition @relation(fields: [currentStageIdMirror], references: [id])
  assignedDepartmentId  String?
  assignedDepartment    Department? @relation(fields: [assignedDepartmentId], references: [id])
  currentStageStatus   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([customerId])
  @@index([workflowVersionIdMirror])
  @@index([currentStageIdMirror])
  @@index([assignedDepartmentId])
}

model Department {
  id                   String                    @id @default(uuid())
  name                 String
  nameLowercase        String                    @unique
  users                User[]
  workflows            WorkflowDefinition[]
  responsibleForStages WorkflowStageDefinition[]
  assignedLoanRequests LoanRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model District {
    id String @id @default(uuid())
    name String @unique
    branches Branch[]
}

model Branch {
    id String @id @default(uuid())
    name String
    districtId String
    district District @relation(fields: [districtId], references: [id])

    @@unique([name, districtId])
}


model Sector {
  id                   String               @id @default(uuid())
  name                 String               @unique
  parentId             String?
  parent               Sector?              @relation("SectorHierarchy", fields: [parentId], references: [id])
  children             Sector[]             @relation("SectorHierarchy")
  workflowDefinitions  WorkflowDefinition[]
  loanRequests         LoanRequest[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model RequestType {
  id           String        @id @default(uuid())
  name         String        @unique
  loanRequests LoanRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model WorkflowDefinition {
  id          String            @id @default(uuid())
  name        String
  description String?
  departmentId String
  department  Department        @relation(fields: [departmentId], references: [id])
  sectorId    String
  sector      Sector            @relation(fields: [sectorId], references: [id])
  order       Int
  versions    WorkflowVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@unique([departmentId, sectorId])
}

model WorkflowVersion {
  id                   String                    @id @default(uuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id])
  versionNumber        Int
  isActive             Boolean                   @default(false)
  stages               WorkflowStageDefinition[]
  loanRequests         LoanRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime?                 @updatedAt
  @@unique([workflowDefinitionId, versionNumber])
}

model WorkflowStageDefinition {
  id                    String                 @id @default(uuid())
  workflowVersionId     String
  workflowVersion       WorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name                  String
  order                 Int
  percentageWeight      Float
  defaultTimelineDays   Int
  responsibleDepartmentId String
  responsibleDepartment Department             @relation(fields: [responsibleDepartmentId], references: [id])
  availableStatuses     Json?
  documentRequirements  DocumentRequirement[]
  loanRequests          LoanRequest[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime?              @updatedAt
  @@unique([workflowVersionId, name])
  @@unique([workflowVersionId, order])
}

enum DocumentRequirementType {
  UPLOAD
  CHECKBOX
}

model DocumentRequirement {
  id              String                  @id @default(uuid())
  workflowStageId String
  workflowStage   WorkflowStageDefinition @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  name            String
  isMandatory     Boolean                 @default(true)
  type            DocumentRequirementType @default(UPLOAD)
  documents       LoanDocument[]
  @@unique([workflowStageId, name])
}

enum LoanDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model LoanDocument {
  id            String             @id @default(uuid())
  loanId        String
  loanRequest   LoanRequest        @relation(fields: [loanId], references: [id])
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  name          String
  status        LoanDocumentStatus @default(PENDING)
  filePath      String?
  notes         String?
  uploadedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@index([loanId])
  @@index([requirementId])
}

model LoanHistoryEntry {
  id                 String      @id @default(uuid())
  loanId             String
  loanRequest        LoanRequest @relation(fields: [loanId], references: [id])
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  stageName          String
  timestamp          DateTime
  notes              String?
  requiredFulfilment String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  @@index([loanId])
  @@index([userId])
}
